# Environment Variables Configuration
# Copy this file to .env or export these in your operating system

# 1. Database Configuration (Default uses H2 in-memory, or switch to MySQL)
SPRING_PROFILES_ACTIVE=h2
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/campus_placement_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# 2. JWT Secret Key (HMAC-SHA256 256-bit Hex Key)
APP_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
APP_JWT_EXPIRATION_MS=86400000

# 3. Google Gemini API Key (Optional: system provides rich domain fallback if omitted)
GEMINI_API_KEY=your_gemini_api_key_here

# 4. Resume Storage Directory
APP_UPLOAD_DIR=./uploads/resumes

