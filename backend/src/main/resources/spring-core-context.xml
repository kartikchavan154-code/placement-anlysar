<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- Demonstration of Spring Core XML-based Bean Definition and Property Injection -->
    <bean id="placementAuditService" class="com.campusplacement.config.XmlPlacementAuditService">
        <property name="auditPrefix" value="[CAMPUS-PLACEMENT-AUDIT]" />
        <property name="version" value="2.0-SpringCoreXML" />
    </bean>

</beans>

